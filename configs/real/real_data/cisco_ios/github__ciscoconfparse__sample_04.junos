snmp {
    community school-ro {
        authorization read-only;
        clients {
            192.0.2.29/24;
        }
    }
    trap-group ESMA {
        targets {
            192.0.2.30;
            192.0.2.31;
            192.0.2.32;
            192.0.2.33;
            192.0.2.34;
        }
    }
}
routing-options {
    static {
        route 0.0.0.0/0 next-hop 192.0.2.35;
    }
}
protocols {
    igmp-snooping {
        vlan all;
    }
    rstp;
    lldp {
        interface all;
    }
    lldp-med {
        interface all;
    }
}
ethernet-switching-options {
    storm-control {
        interface all;
    }
}
vlans {
    management {
        vlan-id 10;
        l3-interface vlan.10;
    }
    private-eth {
        vlan-id 20;
    }
    public-eth {
        vlan-id 30;
    }
    wan {
        vlan-id 100;
        l3-interface vlan.100;
    }
}
